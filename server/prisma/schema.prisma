datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  TENANT_ADMIN
  WORKER
  CUSTOMER
}

enum BookingStatus {
  REQUESTED
  ASSIGNED
  ON_THE_WAY
  STARTED
  COMPLETED
  CANCELLED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         Role      @default(CUSTOMER)
  tenantId     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  bookings     Booking[] @relation("CustomerBookings")
  worker       Worker?
}

model Service {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  category    String
  description String
  icon        String?   @default("🔧")
  basePrice   Float
  durationMin Int
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bookings    Booking[]
}

model Worker {
  id           String    @id @default(uuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id])
  tenantId     String
  skills       String[]
  availability String    @default("available")
  rating       Float     @default(5.0)
  aadhaarValid Boolean   @default(false)
  panValid     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  bookings     Booking[] @relation("WorkerBookings")
}

model Booking {
  id            String        @id @default(uuid())
  tenantId      String
  customerId    String
  customer      User          @relation("CustomerBookings", fields: [customerId], references: [id])
  serviceId     String
  service       Service       @relation(fields: [serviceId], references: [id])
  workerId      String?
  worker        Worker?       @relation("WorkerBookings", fields: [workerId], references: [id])
  status        BookingStatus @default(REQUESTED)
  scheduledDate String
  scheduledTime String
  priceTotal    Float
  taxTotal      Float
  discountTotal Float
  netTotal      Float
  formData      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Lead {
  id              String   @id @default(uuid())
  tenantId        String
  name            String
  phone           String
  email           String?  @default("")
  serviceInterest String?  @default("")
  notes           String?  @default("")
  status          String   @default("new")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TenantRegistration {
  id             String   @id @default(uuid())
  businessName   String
  ownerName      String
  ownerPhone     String
  ownerEmail     String   @unique
  passwordHash   String
  industryType   String   @default("Home Services")
  industries     String[]
  primaryColor   String   @default("#2563eb")
  secondaryColor String   @default("#4f46e5")
  font           String?  @default("Inter, sans-serif")
  plan           String   @default("starter")
  status         String   @default("pending")
  config         Json?
  gstNumber      String?  @db.VarChar(15)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}



