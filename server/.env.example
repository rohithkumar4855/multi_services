# ==========================================
# ServOS Backend Environment Configuration
# ==========================================

PORT=5000
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/servos?schema=public"
JWT_SECRET="your_jwt_secret_key"
ENCRYPTION_KEY="your_aes256_super_secure_key"
NODE_ENV="development"

# ==========================================
# Email Provider Configuration (OTP System)
# ==========================================
# Supported EMAIL_PROVIDER options: "resend" | "smtp"
EMAIL_PROVIDER="smtp"
EMAIL_FROM="ServOS Security <no-reply@servos.in>"

# Option A: Resend API Configuration
RESEND_API_KEY=""

# Option B: SMTP Configuration (e.g. Gmail, SendGrid, Amazon SES, Mailgun)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""

# OTP Security Parameters
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ==========================================
# Supabase S3 Storage Credentials
# ==========================================
SUPABASE_S3_ENDPOINT="https://xxxx.storage.supabase.co/storage/v1/s3"
SUPABASE_S3_REGION="us-east-1"
SUPABASE_S3_ACCESS_KEY_ID=""
SUPABASE_S3_SECRET_ACCESS_KEY=""
SUPABASE_S3_BUCKET="multitenant"
